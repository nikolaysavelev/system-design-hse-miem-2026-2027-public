diff --git a/deploy/charts/soldout/values.yaml b/deploy/charts/soldout/values.yaml
index 950c2a6..80a0805 100644
--- a/deploy/charts/soldout/values.yaml
+++ b/deploy/charts/soldout/values.yaml
@@ -108,3 +108,27 @@ notifier:
     NOTIFIER_BACKOFF: 500ms,1s,2s,4s
     NOTIFIER_CONCURRENCY: "256"
     LOG_FORMAT: json
+
+# Эмулятор почтового шлюза (cmd/mailgw) в кластере. По умолчанию выключен: на стенде mailgw живет в compose,
+# notifier ходит на external.mailgwUrl. При enabled: true notifier ходит на Service mailgw, external.mailgwUrl
+# не используется. Образ soldout-mailgw с тегом image.tag должен быть в кластере (k3d image import).
+mailgw:
+  enabled: false
+  image: soldout-mailgw
+  port: 8090
+  replicas: 1
+  resources:
+    requests: { cpu: 50m, memory: 32Mi }
+    limits: { cpu: 250m, memory: 64Mi }
+  gomemlimit: 50MiB
+  probes:
+    readiness: { path: /healthz, periodSeconds: 3, failureThreshold: 3 }
+    liveness: { path: /healthz, periodSeconds: 10, failureThreshold: 6 }
+  # Пауза перед SIGTERM: под уходит из endpoints раньше, чем перестает принимать соединения.
+  preStopSleepSeconds: 5
+  terminationGracePeriodSeconds: 30
+  pdb:
+    maxUnavailable: 1
+  env:
+    MAILGW_DELAY_MS: "900"       # как в compose (lesson-04.yml); 600 по умолчанию в самом mailgw
+    MAILGW_FAIL_RATE: "0.05"
