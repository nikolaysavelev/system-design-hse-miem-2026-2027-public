// Grafana Alloy, занятие 5: реплики soldout по DNS Docker, pull-профилирование /debug/pprof каждые 15 с → Pyroscope.
discovery.dns "soldout" {
  names            = ["soldout"]
  type             = "A"
  port             = 8080
  refresh_interval = "5s"
}

discovery.relabel "soldout" {
  targets = discovery.dns.soldout.targets
  rule {
    target_label = "service_name"
    replacement  = "soldout"
  }
}

pyroscope.scrape "soldout" {
  targets = discovery.relabel.soldout.output
  forward_to = [pyroscope.write.local.receiver]
  scrape_interval = "15s"
  scrape_timeout  = "20s"

  profiling_config {
    profile.process_cpu { enabled = true }
    profile.memory      { enabled = true }
    profile.goroutine   { enabled = true }
    profile.block       { enabled = false }
    profile.mutex       { enabled = false }
    profile.fgprof      { enabled = false }
  }
}

pyroscope.write "local" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}
